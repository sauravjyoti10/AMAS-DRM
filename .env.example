# Copy this file to .env and fill in your own credentials.
# NEVER commit .env or expose your API key.

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_S=10
GEMINI_BUDGET_S=12

# PostgreSQL
POSTGRES_USER=amas
POSTGRES_PASSWORD=
POSTGRES_DB=amas_drm
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Map and routing
GRAPH_PATH=data/guwahati_roads.graphml
MAX_SNAP_M=1000

# OpenStreetMap geocoding
GEOCODE_ONLINE=true
GEOCODE_USER_AGENT=amas_drm_geocoder
GEOCODE_TIMEOUT_S=6
GEOCODE_BUDGET_S=4
GEOCODE_CACHE_PATH=data/geocode_cache.json

# Hazard zones
HAZARDS_PATH=data/hazards.json
DEFAULT_HAZARD_RADIUS_M=400

# Frontend
FRONTEND_ORIGIN=http://localhost:5173